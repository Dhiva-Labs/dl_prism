<?xml version="1.0" encoding="utf-8"?>
<!--
  DL Prism Mobile talks to a gateway running elsewhere on the user's own
  network, over plain HTTP: a LAN box or a Tailscale/VPN peer typically has
  no real TLS certificate, and Tailscale/VPN traffic is already encrypted at
  the tunnel layer regardless. Android blocks cleartext (non-TLS) HTTP by
  default since API 28, so this file is what makes that traffic possible.

  What this file CANNOT do: Android's network security config only matches
  literal hostnames/IP addresses in <domain> entries — there is no
  declarative syntax for "any RFC 1918 address" or a CIDR range. So this
  file cannot, by itself, express "cleartext for private ranges only", and
  a <base-config> permitting cleartext for every host is the same coarse
  allowance as android:usesCleartextTraffic="true" on the <application> tag.

  What actually enforces "private ranges only": lib/services/
  private_network_guard.dart, used by the Onboarding and Settings screens'
  base-URL validation. It rejects an http:// base URL whose host does not
  parse as a private-use address — RFC 1918 (10/8, 172.16/12, 192.168/16),
  Tailscale's CGNAT range (100.64.0.0/10), loopback, or link-local — before
  the app ever attempts a request to it. A bare hostname (mDNS ".local",
  Tailscale MagicDNS, a router-assigned LAN name) is allowed through that
  guard rather than resolved and checked, since forcing a synchronous DNS
  lookup into a form validator is not worth it for what is, at worst, a
  false negative on an already-unusual setup — see that file's doc comment.
  https:// base URLs are accepted regardless of host, same as any browser.

  The explicit <domain-config> entries below are the two hosts that matter
  for local development specifically: the device's own loopback, and
  10.0.2.2, which is the Android emulator's fixed route back to the host
  machine's loopback (so a gateway run with `prism serve` on the developer's
  own machine is reachable from the emulator without any network config).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Coarse fallback for everything else (arbitrary LAN IPs and VPN/
         Tailscale hosts cannot be enumerated here) — see the note above on
         why the real restriction lives in private_network_guard.dart
         instead. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
